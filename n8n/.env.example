# Same tag is used for n8nio/n8n and n8nio/runners (they must match)
N8N_VERSION=latest
# Sandbox service release (API, runner and sandbox images share it).
# Latest stable "service/vX.Y.Z" from https://github.com/n8n-io/n8n-sandbox-service/releases
N8N_SANDBOX_VERSION=1.8.1

POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me
# Shared secret between n8n and the task-runners container: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=change-me

# n8n Assistant sandbox secrets, each one shared between two services: openssl rand -hex 32
# n8n -> sandbox-api
SANDBOX_API_KEY=change-me
# sandbox-runner-1 -> sandbox-api (registration) and sandbox-api -> sandbox-runner-1 (control)
SANDBOX_RUNNER_REGISTRATION_TOKEN=change-me
SANDBOX_RUNNER_API_KEY=change-me

# SMTP for user invites and password reset emails
N8N_SMTP_HOST=smtp.example.com
# 465 with N8N_SMTP_SSL=true (implicit TLS), 587 with N8N_SMTP_SSL=false (STARTTLS)
N8N_SMTP_PORT=465
N8N_SMTP_SSL=true
N8N_SMTP_USER=n8n@example.com
N8N_SMTP_PASS=change-me
# Display name and address shown in the From header
N8N_SMTP_SENDER="n8n <n8n@example.com>"
